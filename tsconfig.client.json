{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "src/client",
    "outDir": "public/client",
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2022", "DOM.Iterable"],
    "noEmitOnError": true
  },
  "include": ["src/client/**/*.ts"],
  "exclude": ["node_modules", "tmp", ".vercel"]
}
