{
  "name": "notebooks-science",
  "version": "1.0.0",
  "description": "NoteBooks XI - A structured knowledge system for students and educators",
  "scripts": {
    "clean": "node src/scripts/cleanup-stale-src-js.js",
    "clean:src": "npm run clean",
    "dev": "npm run clean && npm run build && node dist/server/server/server.js",
    "start": "node dist/server/server/server.js",
    "build": "npm run clean && node src/scripts/generate-version.js && npm run generate:registry && npm run generate:subject-trees && npm run build:client && npm run build:server",
    "generate:registry": "tsx src/scripts/generate-registry.ts",
    "generate:subject-trees": "tsx src/scripts/generate-subject-trees.ts",
    "generate:trees": "node scripts/generate-stream-trees.js",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "backend": "node dist/server/server/server.js",
    "setup": "npm run dev",
    "test": "vitest run",
    "pretest": "node src/scripts/migrate-db.js || true",
    "migrate": "node src/scripts/migrate-db.js",
    "typecheck": "tsc --noEmit -p tsconfig.server.json"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.21.0",
    "serve": "^14.2.0",
    "supertest": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.1.0",
    "@octokit/rest": "^20.1.2",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.3.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv-cli": "^11.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "resend": "^6.12.4",
    "tsx": "^4.23.12"
  }
}
