{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
    "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/public/html/admin-prs.html" },
    { "source": "/admin/", "destination": "/public/html/admin-prs.html" },
    { "source": "/admin-prs", "destination": "/public/html/admin-prs.html" }
  ]

}
