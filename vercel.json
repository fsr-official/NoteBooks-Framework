{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    { "source": "/dashboard", "destination": "/settings#personal-space", "permanent": false },
    { "source": "/dashboard/", "destination": "/settings#personal-space", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/registry", "destination": "/public/json/repo-registry.json" },
    { "source": "/api/system/:stream", "destination": "/public/json/:stream-tree.json" },
    { "source": "/settings", "destination": "/public/html/settings.html" },
    { "source": "/settings/", "destination": "/public/html/settings.html" },
    { "source": "/admin", "destination": "/public/html/admin.html" },
    { "source": "/admin/", "destination": "/public/html/admin.html" },
    { "source": "/admin-prs", "destination": "/public/html/admin-prs.html" },
    { "source": "/admin-prs/", "destination": "/public/html/admin-prs.html" },
    { "source": "/science", "destination": "/public/html/streams.html" },
    { "source": "/science/", "destination": "/public/html/streams.html" },
    { "source": "/commerce", "destination": "/public/html/streams.html" },
    { "source": "/commerce/", "destination": "/public/html/streams.html" },
    { "source": "/humanities", "destination": "/public/html/streams.html" },
    { "source": "/humanities/", "destination": "/public/html/streams.html" },
    { "source": "/community", "destination": "/public/html/portal.html" },
    { "source": "/community/", "destination": "/public/html/portal.html" },
    { "source": "/issues", "destination": "/public/html/portal.html" },
    { "source": "/issues/", "destination": "/public/html/portal.html" },
    { "source": "/volunteers", "destination": "/public/html/portal.html" },
    { "source": "/volunteers/", "destination": "/public/html/portal.html" },
    { "source": "/accounts", "destination": "/public/html/portal.html" },
    { "source": "/accounts/", "destination": "/public/html/portal.html" },
    { "source": "/about", "destination": "/public/html/portal.html" },
    { "source": "/about/", "destination": "/public/html/portal.html" }
  ],
  "functions": {
    "api/[...all].ts": {
      "includeFiles": [
        "GITHUB-REPOSITORIES.md",
        "files.json",
        "version.json",
        "public/json/*.json",
        "public/html/**/*.html",
        "public/css/**/*.css",
        "public/js/**/*.js",
        "public/client/**/*.js"
      ]
    }
  }
}
