{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist/server",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "noEmitOnError": false
  },
  "include": [
    "src/server/**/*.ts",
    "src/types/**/*.d.ts",
    "src/api/auth.ts",
    "src/api/blob.ts",
    "src/api/config.ts",
    "src/api/desmos.ts",
    "src/api/gh.ts",
    "src/api/raw.ts",
    "src/api/repo-registry.ts",
    "src/api/submit-pr.ts",
    "src/api/_shared.ts"
  ],
  "exclude": ["node_modules", "tmp", ".vercel"]
}
